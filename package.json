{
  "name": "deardhruv.com",
  "version": "2.1.0",
  "private": true,
  "description": "DearDhruv.com - Personal portfolio & engineering blog of Dhruv Patel",
  "scripts": {
    "build": "astro build",
    "build:astro": "astro build",
    "dev": "astro dev",
    "dev:astro": "astro dev",
    "check": "tsc --noEmit",
    "test": "node scripts/verify-routes.js && node tests/verify-assets.js && node tests/verify-links.js && node tests/verify-edge-functions.js && node tests/verify-contrast.js && node tests/verify-a11y-tokens.js && node tests/verify-content-loader.js && node tests/verify-seo-metadata.js && node tests/verify-interactive-containers.js && node tests/verify-employer-portfolio.js",
    "test:routes": "node scripts/verify-routes.js",
    "test:assets": "node tests/verify-assets.js",
    "test:links": "node tests/verify-links.js",
    "test:edge": "node tests/verify-edge-functions.js",
    "test:contrast": "node tests/verify-contrast.js",
    "test:a11y": "node tests/verify-a11y-tokens.js",
    "test:content": "node tests/verify-content-loader.js",
    "test:seo": "node tests/verify-seo-metadata.js",
    "test:interactive": "node tests/verify-interactive-containers.js",
    "test:employer": "node tests/verify-employer-portfolio.js",
    "test:dist": "PUBLIC_DIR=dist node scripts/verify-routes.js && PUBLIC_DIR=dist node tests/verify-assets.js && PUBLIC_DIR=dist node tests/verify-links.js && PUBLIC_DIR=dist node tests/verify-edge-functions.js",
    "test:regression": "node tests/verify-complete-regression.js",
    "test:visual": "node tests/verify-visual-regression.js",
    "test:perf": "node tests/verify-performance-budgets.js",
    "audit": "node scripts/audit.js",
    "audit:health": "node scripts/audit.js --health",
    "audit:seo": "node scripts/audit.js --seo",
    "audit:a11y": "node scripts/audit.js --a11y",
    "audit:perf": "node scripts/audit.js --perf",
    "audit:security": "node scripts/audit.js --security",
    "audit:ai": "node scripts/audit.js --ai",
    "quality:quick": "npm run check && npm test && npm run test:perf",
    "quality:a11y": "node scripts/audit.js --a11y && node tests/verify-a11y-tokens.js && node tests/verify-contrast.js",
    "quality:html": "node scripts/verify-html-standards.js",
    "quality:links": "node tests/verify-links.js && node scripts/verify-routes.js",
    "quality:visual": "node tests/verify-visual-regression.js",
    "quality:browser": "node tests/verify-viewport-matrix.js",
    "quality:perf": "node tests/verify-performance-budgets.js && node scripts/audit.js --perf",
    "quality:security": "node scripts/audit.js --security && node tests/verify-edge-functions.js",
    "quality:report": "node scripts/generate-quality-report.js",
    "quality:release": "node scripts/verify-release-gate.js",
    "new:post": "node scripts/new-post.js"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "astro": "^7.4.4",
    "typescript": "^7.0.2"
  }
}
