---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PaletteSwitcher from '../components/PaletteSwitcher.astro';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article' | 'profile';
  ogImage?: string;
  ogImageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  noindex?: boolean;
  breadcrumbs?: Array<{ name: string; url: string }>;
  schema?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description = "Dhruv Patel (@DearDhruv) - Lead Android Engineer, Android Architect, and Android Artist crafting on-device AI runtimes and high-performance native architectures with extensive production leadership.",
  canonicalUrl,
  ogType = "website",
  ogImage,
  ogImageAlt,
  publishedTime,
  modifiedTime,
  author = "Dhruv Patel (@DearDhruv)",
  tags = [],
  noindex = false,
  breadcrumbs,
  schema
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteOrigin = "https://deardhruv.com";
const normalizedPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const canonical = canonicalUrl || `${siteOrigin}${normalizedPath}`;
const isHtmlFile = canonical.endsWith('.html');
const markdownUrl = !noindex && !isHtmlFile
  ? `${canonical.endsWith('/') ? canonical : canonical + '/'}index.md`
  : null;
const formattedTitle = title.includes('Dhruv Patel') ? title : `${title} :: Dhruv Patel`;
const defaultOgImage = `${siteOrigin}/images/pro_pic_small.jpg`;
const resolvedOgImage = ogImage || defaultOgImage;
const resolvedOgImageAlt = ogImageAlt || `${formattedTitle} - Dhruv Patel`;

// Construct Breadcrumbs
const breadcrumbItems = [
  { name: 'Home', url: `${siteOrigin}/` }
];
if (breadcrumbs && breadcrumbs.length > 0) {
  breadcrumbItems.push(...breadcrumbs);
} else {
  const pathSegments = normalizedPath.split('/').filter(Boolean);
  let accumPath = siteOrigin;
  for (const seg of pathSegments) {
    accumPath += `/${seg}`;
    const readableName = seg
      .replace(/-/g, ' ')
      .replace(/_/g, ' ')
      .replace(/^\d+-/, '')
      .replace(/\b\w/g, l => l.toUpperCase());
    breadcrumbItems.push({ name: readableName, url: `${accumPath}/` });
  }
}

const breadcrumbsListSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: breadcrumbItems.map((item, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: item.name,
    item: item.url
  }))
};

const personSchema = {
  '@type': 'Person',
  '@id': `${siteOrigin}/#person`,
  name: 'Dhruv Patel',
  alternateName: ['DearDhruv', 'deardhruv', '@DearDhruv', 'Dhruv', 'Dhruv Patel (DearDhruv)'],
  identifier: 'deardhruv',
  url: `${siteOrigin}/`,
  image: [
    `${siteOrigin}/pp/pro_pic.jpg`,
    `${siteOrigin}/images/pro_pic_small.jpg`,
    `${siteOrigin}/android-chrome-512x512.png`
  ],
  jobTitle: 'Lead Android Engineer',
  worksFor: {
    '@type': 'Organization',
    name: 'Impact Commerce',
    url: 'https://impactcommerce.com/'
  },
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'Nirma University',
    url: 'https://nirmauni.ac.in/'
  },
  award: [
    '3rd Place in State-level Web Designing Competition, ISTE Student Chapter, TechFest 2010 at Nirma University'
  ],
  hasOccupation: [
    {
      '@type': 'Occupation',
      name: 'Lead Android Engineer',
      occupationLocation: { '@type': 'Country', name: 'Denmark & India' },
      skills: 'Native Android Architecture, Jetpack Compose, Kotlin, Android NDK C++, Hardware Abstraction Layers (HAL), In-Store Touch Displays'
    },
    {
      '@type': 'Occupation',
      name: 'Senior Android Developer',
      skills: 'FFmpeg Video Processing, Jetpack Compose, Canvas Manipulation, MVVM Architecture'
    },
    {
      '@type': 'Occupation',
      name: 'Mobile Systems Architect',
      skills: 'On-Device AI, llama.cpp, Google AI Edge LiteRT, Apple MLX, Speculative Decoding, Vulkan'
    }
  ],
  performerIn: [
    {
      '@type': 'Event',
      name: 'GDG DevFest Surat 2025: Jetpack Compose Game Changing Features',
      startDate: '2025-12-01',
      location: { '@type': 'Place', name: 'Surat, India' }
    },
    {
      '@type': 'Event',
      name: 'GDG DevFest Ahmedabad 2025: Android 17 Mandates Adaptive Layouts',
      startDate: '2025-11-01',
      location: { '@type': 'Place', name: 'Ahmedabad, India' }
    }
  ],
  description: 'Lead Android Engineer, Android Architect, and Android Artist building on-device AI runtimes and high-performance native architectures with extensive production leadership.',
  disambiguatingDescription: 'Lead Android Engineer, Android Architect, and Android Artist known online as @DearDhruv, specializing in on-device AI inference, Kotlin Multiplatform, native C++ NDK, and offline-first mobile systems.',
  mainEntityOfPage: `${siteOrigin}/`,
  knowsLanguage: ['en', 'gu', 'hi'],
  sameAs: [
    'https://github.com/DearDhruv',
    'https://x.com/DearDhruv',
    'https://twitter.com/DearDhruv',
    'https://www.linkedin.com/in/deardhruv',
    'https://instagram.com/deardhruv',
    'https://about.me/deardhruv',
    'https://huggingface.co/deardhruv',
    'https://medium.com/@DearDhruv',
    'https://stackoverflow.com/users/596566/deardhruv',
    'https://www.youtube.com/user/Dhruvein',
    'https://www.reddit.com/user/DearDhruv/',
    'https://play.google.com/store/apps/dev?id=5177092407740817842'
  ],
  knowsAbout: [
    'Android Architecture',
    'Kotlin Multiplatform (KMP)',
    'On-Device AI Runtimes',
    'On-Device Image Generation',
    'Compose Multiplatform',
    'llama.cpp',
    'Google AI Edge LiteRT',
    'Apple MLX',
    'Modern C++20 / NDK',
    'Vulkan Compute',
    'OpenCL',
    'Metal Compute',
    'ARM NEON & KleidiAI',
    'Clean Architecture',
    'MVI (Model-View-Intent)',
    'Offline-First Systems',
    'Speculative Decoding',
    'Hardware Abstraction Layers (HAL)',
    'POSIX fork() Sandboxing',
    'Android Low Memory Killer (LMK)',
    'SQLDelight & SQLite',
    'Cloud Firestore Schema v5',
    'Android TV & Leanback'
  ]
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': `${siteOrigin}/#website`,
  url: `${siteOrigin}/`,
  name: 'Dhruv Patel',
  alternateName: ['DearDhruv', 'deardhruv', 'deardhruv.com', 'Dhruv Patel (@DearDhruv)'],
  description: 'Personal portfolio, engineering case studies, and systems architecture articles by Dhruv Patel (@DearDhruv).',
  publisher: { '@id': `${siteOrigin}/#person` },
  creator: { '@id': `${siteOrigin}/#person` },
  about: { '@id': `${siteOrigin}/#person` },
  inLanguage: 'en-US'
};

let pageSchema: Record<string, any>;
if (ogType === 'article') {
  pageSchema = {
    '@type': 'TechArticle',
    '@id': `${canonical}#article`,
    isPartOf: { '@id': `${siteOrigin}/#website` },
    headline: title,
    description: description,
    inLanguage: 'en-US',
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    author: { '@id': `${siteOrigin}/#person` },
    publisher: {
      '@type': 'Person',
      '@id': `${siteOrigin}/#person`,
      name: 'Dhruv Patel',
      url: `${siteOrigin}/`,
      image: `${siteOrigin}/pp/pro_pic.jpg`
    },
    image: resolvedOgImage,
    datePublished: publishedTime || '2026-10-05T10:00:00+05:30',
    dateModified: modifiedTime || publishedTime || '2026-10-21T15:30:00+05:30',
    keywords: tags,
    articleSection: 'Mobile Systems & On-Device AI',
    proficiencyLevel: 'Expert',
    dependencies: 'Kotlin Multiplatform, Android NDK, llama.cpp, Google AI Edge LiteRT',
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.page-title', '.page-lead', '.prose > p:first-of-type']
    }
  };
} else if (normalizedPath === '/') {
  pageSchema = {
    '@type': 'ProfilePage',
    '@id': `${siteOrigin}/#webpage`,
    url: `${siteOrigin}/`,
    name: formattedTitle,
    isPartOf: { '@id': `${siteOrigin}/#website` },
    about: { '@id': `${siteOrigin}/#person` },
    mainEntity: { '@id': `${siteOrigin}/#person` },
    description: description,
    inLanguage: 'en-US',
    primaryImageOfPage: `${siteOrigin}/images/pro_pic_small.jpg`,
    significantLink: [
      `${siteOrigin}/portfolio/`,
      `${siteOrigin}/projects/`,
      `${siteOrigin}/posts/ai_playground_series/`,
      `${siteOrigin}/about/`,
      `${siteOrigin}/resume.pdf`
    ]
  };
} else if (normalizedPath === '/portfolio/') {
  pageSchema = {
    '@type': 'ProfilePage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: formattedTitle,
    isPartOf: { '@id': `${siteOrigin}/#website` },
    about: { '@id': `${siteOrigin}/#person` },
    mainEntity: { '@id': `${siteOrigin}/#person` },
    description: description,
    inLanguage: 'en-US',
    significantLink: [
      `${siteOrigin}/projects/`,
      `${siteOrigin}/resume.pdf`,
      'https://play.google.com/store/apps/details?id=com.deardhruv.llmplayground',
      'https://play.google.com/store/apps/details?id=com.deardhruv.velocihue'
    ]
  };
} else if (normalizedPath === '/about/') {
  pageSchema = {
    '@type': 'AboutPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: formattedTitle,
    isPartOf: { '@id': `${siteOrigin}/#website` },
    about: { '@id': `${siteOrigin}/#person` },
    mainEntity: { '@id': `${siteOrigin}/#person` },
    description: description,
    inLanguage: 'en-US'
  };
} else if (normalizedPath === '/projects/' || normalizedPath === '/posts/' || normalizedPath === '/posts/ai_playground_series/') {
  pageSchema = {
    '@type': 'CollectionPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: formattedTitle,
    isPartOf: { '@id': `${siteOrigin}/#website` },
    about: { '@id': `${siteOrigin}/#person` },
    description: description,
    inLanguage: 'en-US'
  };
} else {
  pageSchema = {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: formattedTitle,
    isPartOf: { '@id': `${siteOrigin}/#website` },
    description: description,
    inLanguage: 'en-US'
  };
}

const aboutFaqSchema = normalizedPath === '/about/' ? {
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Who is Dhruv Patel (@DearDhruv)?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Dhruv Patel is a Lead Android Engineer, Android Architect, and Android Artist based in India with 15+ years of experience in native mobile systems, Kotlin Multiplatform, on-device AI runtimes, and retail hardware integrations. He is the creator of AI Playground and VelociHue.'
      }
    },
    {
      '@type': 'Question',
      name: 'What does Dhruv Patel specialize in?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Dhruv specializes in native Android development (Kotlin, Jetpack Compose, C++20 NDK), Kotlin Multiplatform (CMP 1.12), on-device AI runtimes (llama.cpp, Google AI Edge LiteRT, Apple MLX), speculative decoding, defensive POSIX fork() process sandboxing, and retail POS hardware integrations.'
      }
    },
    {
      '@type': 'Question',
      name: 'What is AI Playground?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'AI Playground is an offline-first, on-device multimodal AI workstation for Android and iOS that runs local LLMs and diffusion models with zero cloud dependencies. It features dual-model Speculative Turbo decoding for 2x speedups, a defensive fork() child process sandbox for Vulkan driver crash isolation, and a pure-KMP document parser for 25+ formats.'
      }
    },
    {
      '@type': 'Question',
      name: 'What is VelociHue?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'VelociHue is a high-framerate arcade game built in Kotlin Multiplatform and Compose Multiplatform for Android, Android TV, and iOS. It runs a shared deterministic physics loop at 60-120 FPS with Cloud Firestore schema v5 sync and 29 achievements.'
      }
    },
    {
      '@type': 'Question',
      name: 'Where has Dhruv Patel worked?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Dhruv has worked as Lead Android Engineer at IMPACT Commerce (Feb 2022-Present), Senior Android Developer at PLANOLY (Nov 2018-Feb 2022), Tech Lead at Ashapura Softech (Jun 2016-Oct 2018), Team Lead at Russmedia Tech (Feb 2014-Jun 2016), and Junior Android Developer at Hidden Brains (Jan 2012-Dec 2013).'
      }
    }
  ]
} : null;

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    personSchema,
    websiteSchema,
    pageSchema,
    breadcrumbsListSchema,
    ...(aboutFaqSchema ? [aboutFaqSchema] : []),
    ...(Array.isArray(schema) ? schema : schema ? [schema] : [])
  ]
};
---

<!DOCTYPE html>
<html lang="en" data-theme="dark" data-palette="amber">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{formattedTitle}</title>
  <meta name="title" content={formattedTitle}>
  <meta name="description" content={description}>
  <meta name="author" content={author}>
  <meta name="keywords" content={tags && tags.length > 0 ? tags.concat(['deardhruv', 'DearDhruv', '@DearDhruv', 'Dhruv Patel']).join(', ') : 'deardhruv, DearDhruv, @DearDhruv, Dhruv Patel, Lead Android Engineer, Android Architect, Android Artist, AI Playground, VelociHue, on-device AI, Kotlin Multiplatform, mobile architecture'}>
  <link rel="canonical" href={canonical}>

  <!-- Robots Directives & Search Bot Hygiene -->
  {noindex ? (
    <>
      <meta name="robots" content="noindex, follow">
      <meta name="googlebot" content="noindex, follow">
      <meta name="bingbot" content="noindex, follow">
    </>
  ) : (
    <>
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
      <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
      <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    </>
  )}

  <!-- Open Graph / Facebook / LinkedIn / Discord / Slack -->
  <meta property="og:site_name" content="Dhruv Patel">
  <meta property="og:locale" content="en_US">
  <meta property="og:type" content={ogType}>
  <meta property="og:title" content={formattedTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={resolvedOgImage}>
  <meta property="og:image:secure_url" content={resolvedOgImage}>
  <meta property="og:image:width" content="800">
  <meta property="og:image:height" content="800">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:alt" content={resolvedOgImageAlt}>
  <meta property="profile:username" content="DearDhruv">

  {ogType === 'article' && publishedTime && (
    <meta property="article:published_time" content={publishedTime}>
  )}
  {ogType === 'article' && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime}>
  )}
  {ogType === 'article' && (
    <>
      <meta property="article:author" content="https://deardhruv.com/">
      <meta property="article:section" content="Mobile Architecture & On-Device AI">
    </>
  )}
  {ogType === 'article' && tags && tags.map(tag => (
    <meta property="article:tag" content={tag}>
  ))}

  <!-- Twitter / X Cards -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@DearDhruv">
  <meta name="twitter:creator" content="@DearDhruv">
  <meta name="twitter:title" content={formattedTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={resolvedOgImage}>
  <meta name="twitter:image:alt" content={resolvedOgImageAlt}>

  <!-- Favicons, Touch Icons & Web App Manifest -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#f59e0b">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#f59e0b">

  <!-- AI Crawling, Agent Protocols & Machine-Readable Feeds -->
  <link rel="describedby" href="/llms.txt" type="text/markdown">
  <link rel="help" href="/llms-full.txt" type="text/markdown">
  <link rel="mcp" href="/.well-known/mcp.json" type="application/json">
  <link rel="api-catalog" href="/.well-known/api-catalog" type="application/linkset+json">
  <link rel="service-doc" href="/auth.md" type="text/markdown">
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">
  <link rel="alternate" type="application/feed+json" href="/index.json" title="Dhruv Patel JSON Feed">
  <link rel="alternate" type="application/rss+xml" href="/index.xml" title="Dhruv Patel RSS Feed">
  {markdownUrl && (
    <link rel="alternate" type="text/markdown" href={markdownUrl} title="Markdown format for AI agents">
  )}
  <meta name="ai-agent" content="enabled=true; policy=/llms.txt; format=markdown">

  <!-- Structured Data / JSON-LD Knowledge Graph -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph, null, 2)} />

  <!-- Design System Token Sheets -->
  <link rel="stylesheet" href="/css/design-system.css?v=2.3.2">
  <link rel="stylesheet" href="/css/typography.css?v=2.3.2">
  <link rel="stylesheet" href="/css/layout.css?v=2.3.2">
  <link rel="stylesheet" href="/css/components.css?v=2.3.2">
  <link rel="stylesheet" href="/css/nav.css?v=2.3.2">

  <!-- Zero-flash synchronous theme and palette initialization -->
  <script is:inline>
    (() => {
      try {
        const q = new URLSearchParams(window.location.search), ls = localStorage, doc = document.documentElement;
        const t = q.get('theme'), p = q.get('palette'), sw = q.get('palette-switcher');
        const v = ['cyan', 'emerald', 'amber', 'indigo'];
        const sysDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        doc.setAttribute('data-theme', (t === 'light' || t === 'dark') ? t : (ls.getItem('theme') || 'dark'));
        const validP = v.includes(p) ? p : null;
        const hasChoice = ls.getItem('palette_user_selected') === 'true';
        const storedP = ls.getItem('palette');
        doc.setAttribute('data-palette', validP || (hasChoice && v.includes(storedP) ? storedP : 'amber'));
        if (validP) { try { ls.setItem('palette', validP); ls.setItem('palette_user_selected', 'true'); } catch (_) {} }
        if (sw === 'true' || sw === '1' || p === 'true' || p === '1' || validP) {
          try { ls.setItem('palette_switcher_enabled', 'true'); } catch (_) {}
        } else if (sw === 'false' || sw === '0' || p === 'false' || p === '0') {
          try { ls.setItem('palette_switcher_enabled', 'false'); } catch (_) {}
        }
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
          doc.classList.add('js-scroll-animate');
        }
      } catch (_) {}
    })();
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>

  <Header currentPath={currentPath} />
  <div class="site-nav-backdrop" id="site-nav-backdrop" aria-hidden="true"></div>

  <main id="main">
    <slot />
  </main>

  <Footer />

  <PaletteSwitcher />

  <script is:inline src="/js/theme-toggle.js?v=2.3.2"></script>
  <script is:inline>
    (() => {
      const menuBtn = document.getElementById('menu-toggle');
      const siteNav = document.getElementById('site-navigation');
      const backdrop = document.getElementById('site-nav-backdrop');

      function updateNavPosition() {
        if (!siteNav || !menuBtn || !siteNav.classList.contains('is-open')) return;
        try {
          const bR = menuBtn.getBoundingClientRect();
          const headerInner = menuBtn.closest('.site-header-inner') || document.querySelector('.site-header-inner');
          if (headerInner) {
            const hR = headerInner.getBoundingClientRect();
            const rightOffset = Math.round(hR.right - bR.right);
            siteNav.style.right = rightOffset + 'px';
            siteNav.style.left = 'auto';
          }
        } catch (_) {}
      }

      function closeMenu() {
        if (!siteNav || !siteNav.classList.contains('is-open')) return;
        siteNav.classList.remove('is-open');
        document.body.classList.remove('menu-open');
        siteNav.style.right = '';
        siteNav.style.left = '';
        if (menuBtn) {
          menuBtn.setAttribute('aria-expanded', 'false');
          menuBtn.classList.remove('is-active');
        }
        if (backdrop) backdrop.classList.remove('is-open');
      }

      function toggleMenu() {
        if (!siteNav || !menuBtn) return;
        const open = siteNav.classList.toggle('is-open');
        document.body.classList.toggle('menu-open', open);
        menuBtn.setAttribute('aria-expanded', String(open));
        menuBtn.classList.toggle('is-active', open);
        if (backdrop) backdrop.classList.toggle('is-open', open);
        if (open) {
          updateNavPosition();
        } else {
          siteNav.style.right = '';
          siteNav.style.left = '';
        }
      }

      if (menuBtn && siteNav) {
        menuBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleMenu();
        });

        if (backdrop) {
          backdrop.addEventListener('click', closeMenu);
          backdrop.addEventListener('touchstart', closeMenu, { passive: true });
        }

        // Close when clicking or touching outside
        document.addEventListener('click', (e) => {
          if (siteNav.classList.contains('is-open') && !siteNav.contains(e.target) && !menuBtn.contains(e.target)) {
            closeMenu();
          }
        });

        document.addEventListener('touchstart', (e) => {
          if (siteNav.classList.contains('is-open') && !siteNav.contains(e.target) && !menuBtn.contains(e.target)) {
            closeMenu();
          }
        }, { passive: true });

        // Close when any link inside siteNav is clicked
        siteNav.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', closeMenu);
        });

        // Accessible keyboard navigation (Escape to close, Tab focus trapping)
        document.addEventListener('keydown', (e) => {
          if (!siteNav.classList.contains('is-open')) return;
          if (e.key === 'Escape') {
            closeMenu();
            menuBtn.focus();
            return;
          }
          if (e.key === 'Tab') {
            const focusables = [menuBtn, ...siteNav.querySelectorAll('a[href], button:not([disabled])')];
            if (focusables.length === 0) return;
            const first = focusables[0];
            const last = focusables[focusables.length - 1];
            if (e.shiftKey && document.activeElement === first) {
              e.preventDefault();
              last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        });

        function handleViewportResize() {
          if (window.innerWidth > 1024) {
            closeMenu();
          } else {
            updateNavPosition();
          }
        }
        window.addEventListener('resize', handleViewportResize, { passive: true });
        window.addEventListener('orientationchange', handleViewportResize, { passive: true });
      }
    })();
  </script>

  <style is:inline>
    .mermaid-chart-container {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      overflow-x: auto;
      margin: var(--space-6, 1.5rem) 0;
      padding: var(--space-4, 1rem);
      background-color: var(--color-bg-surface-elevated, #18181b);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-lg, 12px);
      box-sizing: border-box;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    }
    .mermaid-chart-container svg {
      max-width: 100%;
      height: auto;
      display: block;
      margin: 0 auto;
    }
  </style>

  <script is:inline>
    (() => {
      let mermaidInstance = null;
      let rendering = false;

      function getMermaidConfig(isLight) {
        const docStyle = window.getComputedStyle(document.documentElement);
        const accent = docStyle.getPropertyValue('--color-accent').trim() || (isLight ? '#b45309' : '#fbbf24');
        return {
          startOnLoad: false,
          securityLevel: 'loose',
          theme: isLight ? 'neutral' : 'dark',
          themeVariables: isLight ? {
            primaryColor: '#f1f5f9',
            primaryTextColor: '#0f172a',
            primaryBorderColor: accent,
            lineColor: accent,
            secondaryColor: '#ffffff',
            tertiaryColor: '#f8fafc',
            fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif'
          } : {
            darkMode: true,
            background: '#0f172a',
            primaryColor: '#1e293b',
            primaryTextColor: '#f8fafc',
            primaryBorderColor: accent,
            lineColor: accent,
            secondaryColor: '#18181b',
            tertiaryColor: '#09090b',
            fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif'
          }
        };
      }

      async function renderMermaidCharts() {
        const pres = document.querySelectorAll('pre[data-language="mermaid"]');
        const containers = document.querySelectorAll('.mermaid-chart-container[data-mermaid-code]');
        if (!pres.length && !containers.length) return;
        if (rendering) return;
        rendering = true;

        try {
          if (!mermaidInstance) {
            const m = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
            mermaidInstance = m.default;
          }

          const isLight = document.documentElement.getAttribute('data-theme') === 'light';
          mermaidInstance.initialize(getMermaidConfig(isLight));

          for (let i = 0; i < pres.length; i++) {
            const pre = pres[i];
            const rawCode = pre.textContent.trim();
            const chartId = 'mermaid-chart-' + i + '-' + Math.random().toString(36).substring(2, 8);
            try {
              const { svg } = await mermaidInstance.render(chartId, rawCode);
              const wrapper = document.createElement('div');
              wrapper.className = 'mermaid-chart-container';
              wrapper.setAttribute('data-mermaid-code', encodeURIComponent(rawCode));
              wrapper.innerHTML = svg;
              pre.parentNode.replaceChild(wrapper, pre);
            } catch (err) {
              console.warn('Mermaid render error for chart ' + i, err);
            }
          }

          for (let i = 0; i < containers.length; i++) {
            const c = containers[i];
            const rawCode = decodeURIComponent(c.getAttribute('data-mermaid-code') || '');
            if (!rawCode) continue;
            const chartId = 'mermaid-rechart-' + i + '-' + Math.random().toString(36).substring(2, 8);
            try {
              const { svg } = await mermaidInstance.render(chartId, rawCode);
              c.innerHTML = svg;
            } catch (err) {
              console.warn('Mermaid re-render error for chart ' + i, err);
            }
          }
        } catch (e) {
          console.warn('Failed to load Mermaid:', e);
        } finally {
          rendering = false;
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderMermaidCharts);
      } else {
        renderMermaidCharts();
      }

      const observer = new MutationObserver((mutations) => {
        for (const m of mutations) {
          if (m.type === 'attributes' && (m.attributeName === 'data-theme' || m.attributeName === 'data-palette')) {
            renderMermaidCharts();
            break;
          }
        }
      });
      observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'data-palette'] });
    })();
  </script>
</body>
</html>
