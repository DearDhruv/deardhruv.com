---
import PageLayout from '../../layouts/PageLayout.astro';
import { getEntry, render } from 'astro:content';

const aboutEntry = await getEntry('pages', 'about');
if (!aboutEntry) {
  throw new Error('Missing content/about.md entry');
}
const { Content } = await render(aboutEntry);

const aboutDescription = aboutEntry.data.description || "About Dhruv Patel (@DearDhruv) - Lead Android Engineer, Android Architect, and Android Artist specializing in on-device AI runtimes, native C++ NDK, and offline-first mobile systems.";
---

<PageLayout
  title={aboutEntry.data.title}
  description={aboutDescription}
  containerClass="layout-container-wide"
>
  <div class="prose">
    <Content />
  </div>
</PageLayout>
