---
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';
import { getEntry, render } from 'astro:content';

const post = await getEntry('posts', 'ai_playground_series/04-i-put-an-image-generator-inside-the-phone');
if (!post) {
  throw new Error('Missing article 04 in posts collection');
}
const { Content } = await render(post);
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  date="Oct 5, 2026"
  readingTime="11 min read"
  tags={post.data.tags}
  series={{ name: "Beyond the Model", part: 4, total: 6 }}
>
  <Content />
</ArticleLayout>
