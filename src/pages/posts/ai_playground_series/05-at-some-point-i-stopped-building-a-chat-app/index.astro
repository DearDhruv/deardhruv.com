---
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';
import { getEntry, render } from 'astro:content';

const post = await getEntry('posts', 'ai_playground_series/05-at-some-point-i-stopped-building-a-chat-app');
if (!post) {
  throw new Error('Missing article 05 in posts collection');
}
const { Content } = await render(post);
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  date="Oct 5, 2026"
  readingTime="12 min read"
  tags={post.data.tags}
  series={{ name: "Beyond the Model", part: 5, total: 6 }}
>
  <Content />
</ArticleLayout>
