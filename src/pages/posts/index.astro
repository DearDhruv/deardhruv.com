---
import PageLayout from '../../layouts/PageLayout.astro';

const seriesArticles = [
  {
    num: "Part 1",
    title: "I Wanted the Model to Stay on the Phone",
    slug: "01-i-wanted-the-model-to-stay-on-the-phone",
    desc: "Why running language models locally matters for privacy, exploring llama.cpp and ARM NEON acceleration, and the realities of moving beyond toy chat boxes.",
    readingTime: "10 min read",
    date: "Oct 5, 2026",
    tags: ["Android", "iOS", "Kotlin Multiplatform", "On-Device AI", "llama.cpp"]
  },
  {
    num: "Part 2",
    title: "The Day a Chat Box Became a Document Engine",
    slug: "02-the-day-a-chat-box-became-a-document-engine",
    desc: "How a simple 'attach file' button turned into an offline ingestion pipeline for 25+ formats using pure RFC 1951 Deflate and memory-mapped chunks.",
    readingTime: "9 min read",
    date: "Oct 5, 2026",
    tags: ["Android", "iOS", "Kotlin Multiplatform", "RAG", "On-Device AI"]
  },
  {
    num: "Part 3",
    title: "The Model Was Fine. The Phone Wasn't.",
    slug: "03-the-model-was-fine-the-phone-wasnt",
    desc: "Handling the hardest bugs: Android Low Memory Killer (LMK) evictions, GPU driver crashes on Vulkan, thermal throttling, and native lifecycle management.",
    readingTime: "10 min read",
    date: "Oct 5, 2026",
    tags: ["Android", "Performance", "Vulkan", "NDK", "Memory"]
  },
  {
    num: "Part 4",
    title: "I Put an Image Generator Inside the Phone",
    slug: "04-i-put-an-image-generator-inside-the-phone",
    desc: "Integrating on-device diffusion models with Google LiteRT and Bonsai Image Ternary 4B, managing dynamic feature delivery, and preventing mobile GPU overheating.",
    readingTime: "11 min read",
    date: "Oct 5, 2026",
    tags: ["Android", "iOS", "Diffusion Models", "LiteRT", "On-Device AI"]
  },
  {
    num: "Part 5",
    title: "At Some Point I Stopped Building a Chat App",
    slug: "05-at-some-point-i-stopped-building-a-chat-app",
    desc: "Refactoring a monolithic mobile app into a multi-module MVI platform with clean offline boundaries, strict state stores, and zero cloud leaks.",
    readingTime: "12 min read",
    date: "Oct 5, 2026",
    tags: ["Android", "iOS", "Architecture", "KMP", "MVI"]
  },
  {
    num: "Part 6",
    title: "Pushing Mobile Hardware to the Edge",
    slug: "06-pushing-mobile-hardware-to-the-edge",
    desc: "Engineering dual-model speculative drafting for 2x decoding speed, isolating GPU driver segmentation faults in a native fork() sandbox, and streaming fault tolerance.",
    readingTime: "11 min read",
    date: "Oct 21, 2026",
    tags: ["Android", "iOS", "Speculative Decoding", "Vulkan", "NDK", "Performance"]
  }
];
---

<PageLayout
  title="Posts"
  lead="Articles, guides, and engineering series by Dhruv Patel."
  containerClass="layout-container-wide"
>
  <!-- FEATURED SERIES -->
  <section class="card" style="margin-bottom: var(--space-12); padding: var(--space-8);">
    <div style="display: flex; gap: var(--space-2); align-items: center; margin-bottom: var(--space-3); flex-wrap: wrap;">
      <span class="badge">Featured Series &bull; 6 Parts</span>
      <span class="chip">Complete</span>
    </div>
    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-4); flex-wrap: wrap; margin-bottom: var(--space-2);">
      <h2 style="font-size: var(--font-h2); margin: 0;">
        <a href="/posts/ai_playground_series/" style="text-decoration: none; color: inherit;">
          Beyond the Model: Building a Private AI Playground
        </a>
      </h2>
      <a href="/posts/ai_playground_series/" class="btn btn-secondary" style="white-space: nowrap;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        <span>Series Overview</span>
      </a>
    </div>
    <p style="color: var(--color-text-secondary); line-height: 1.6; margin-bottom: var(--space-6);">
      An in-depth 6-part engineering series exploring what it really takes to build an offline-first, on-device multimodal AI workstation for Android and iOS using Kotlin Multiplatform, C++20 / NDK, llama.cpp, and Google LiteRT.
    </p>

    <div class="layout-grid-2" style="gap: var(--space-3);">
      {seriesArticles.map(art => (
        <a
          href={`/posts/ai_playground_series/${art.slug}/`}
          class="card card-interactive"
          style="padding: var(--space-4); text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: var(--space-1); border-color: var(--color-border-subtle);"
        >
          <span style="font-family: var(--font-mono); font-size: var(--font-overline); text-transform: uppercase; color: var(--color-accent); font-weight: 700;">{art.num}</span>
          <span class="card-title" style="font-weight: 600; font-size: var(--font-body);">{art.title}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ALL ARTICLES ARCHIVE -->
  <section>
    <h2 style="font-size: var(--font-h2); margin-bottom: var(--space-6); border-bottom: 1px solid var(--color-divider); padding-bottom: var(--space-3);">
      All Published Articles
    </h2>

    <div style="display: flex; flex-direction: column; gap: var(--space-6);">
      {seriesArticles.map(art => (
        <article class="card card-interactive" style="padding: var(--space-6);">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--space-2); flex-wrap: wrap; gap: var(--space-2);">
            <h3 style="font-size: var(--font-h3); margin: 0;">
              <a href={`/posts/ai_playground_series/${art.slug}/`} class="card-stretched-link" style="text-decoration: none; color: inherit;">
                {art.num} - {art.title}
              </a>
            </h3>
            <div style="font-family: var(--font-mono); font-size: var(--font-small); color: var(--color-text-secondary);">
              <span>{art.readingTime}</span> &middot; <time>{art.date}</time>
            </div>
          </div>
          <p style="color: var(--color-text-secondary); line-height: 1.6; margin: 0 0 var(--space-4) 0; font-size: var(--font-body-small);">
            {art.desc}
          </p>
          <div class="layout-cluster">
            {art.tags.map(tag => (
              <span class="chip">{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</PageLayout>
