---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 Not Found"
  description="The requested page could not be found on DearDhruv.com."
  canonicalUrl="https://deardhruv.com/404.html"
>
  <div class="layout-container-reading" style="padding-top: var(--space-16); padding-bottom: var(--space-16); text-align: center;">
    <div style="font-family: var(--font-mono); font-size: clamp(3rem, 8vw, 5rem); font-weight: 800; color: var(--color-accent); line-height: 1; margin-bottom: var(--space-4);">
      404
    </div>
    <h1 class="page-title" style="margin-bottom: var(--space-4);">Page not found</h1>
    <p class="page-lead" style="margin-bottom: var(--space-8); color: var(--color-text-secondary); max-width: 48ch; margin-left: auto; margin-right: auto;">
      The page you are looking for doesn't exist, has been moved, or is temporarily unavailable.
    </p>
    <div class="layout-cluster" style="justify-content: center; gap: var(--space-4);">
      <a href="/" class="btn btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        <span>Return Home</span>
      </a>
      <a href="/posts/" class="btn btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="21 8 21 21 3 21 3 8"/><rect width="22" height="5" x="1" y="3"/><line x1="10" x2="14" y1="12" y2="12"/></svg>
        <span>Browse Posts</span>
      </a>
    </div>
  </div>
</BaseLayout>
