---
import PageLayout from '../../layouts/PageLayout.astro';
import { getEntry, render } from 'astro:content';

const portfolioEntry = await getEntry('pages', 'portfolio');
if (!portfolioEntry) {
  throw new Error('Missing content/portfolio.md entry');
}
const { Content } = await render(portfolioEntry);

const portfolioSchemas = [
  {
    '@type': 'SoftwareApplication',
    '@id': 'https://deardhruv.com/portfolio/#ai-playground',
    name: 'AI Playground',
    alternateName: 'LLM Playground',
    operatingSystem: 'Android, iOS',
    applicationCategory: 'DeveloperApplication',
    author: { '@id': 'https://deardhruv.com/#person' },
    creator: { '@id': 'https://deardhruv.com/#person' },
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD'
    },
    installUrl: 'https://play.google.com/store/apps/details?id=com.deardhruv.llmplayground',
    downloadUrl: 'https://play.google.com/store/apps/details?id=com.deardhruv.llmplayground',
    description: 'Offline-first, on-device multimodal AI workstation for Android and iOS running local LLMs, speculative decoding, and diffusion models with zero cloud telemetry.'
  },
  {
    '@type': 'SoftwareApplication',
    '@id': 'https://deardhruv.com/portfolio/#velocihue',
    name: 'VelociHue',
    operatingSystem: 'Android, Android TV, iOS',
    applicationCategory: 'GameApplication',
    author: { '@id': 'https://deardhruv.com/#person' },
    creator: { '@id': 'https://deardhruv.com/#person' },
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD'
    },
    installUrl: 'https://play.google.com/store/apps/details?id=com.deardhruv.velocihue',
    downloadUrl: 'https://play.google.com/store/apps/details?id=com.deardhruv.velocihue',
    description: 'High-framerate arcade action game engineered in Kotlin Multiplatform and Compose Multiplatform for Android, Android TV, and iOS.'
  },
  {
    '@type': 'FAQPage',
    '@id': 'https://deardhruv.com/portfolio/#faq',
    mainEntity: [
      {
        '@type': 'Question',
        name: "What is Dhruv Patel's current engineering role?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Dhruv Patel serves as Lead Android Engineer at IMPACT Commerce, specializing in in-store Android OS touch display systems, retail hardware abstraction layers (HAL), and modular Jetpack Compose applications.'
        }
      },
      {
        '@type': 'Question',
        name: 'How much professional mobile systems experience does Dhruv Patel have?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Dhruv Patel has 15+ years of professional mobile engineering experience (started professionally in Jan 2012), with extensive team leadership and architecture across IMPACT Commerce, PLANOLY, Ashapura Softech, and Russmedia Tech.'
        }
      },
      {
        '@type': 'Question',
        name: 'What independent products has Dhruv Patel engineered?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Dhruv is the creator of AI Playground (an offline-first, on-device multimodal AI workstation running local LLMs and diffusion models with zero cloud roundtrips) and VelociHue (a 60-120 FPS arcade action game built with Kotlin Multiplatform and Compose Multiplatform).'
        }
      }
    ]
  }
];
---

<PageLayout
  title={portfolioEntry.data.title}
  description={portfolioEntry.data.description || "Dhruv Patel's professional portfolio showcasing native Android architecture, Kotlin Multiplatform, on-device AI runtimes, and engineering leadership."}
  containerClass="layout-container-wide"
  schema={portfolioSchemas}
>
  <div class="prose">
    <Content />
  </div>
</PageLayout>
