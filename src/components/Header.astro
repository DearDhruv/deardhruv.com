---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { href: "/", label: "Home", exact: true },
  { href: "/about/", label: "About", exact: false },
  { href: "/portfolio/", label: "Portfolio", exact: false },
  { href: "/projects/", label: "Projects", exact: false },
  { href: "/posts/", label: "Writing", exact: false },
  { href: "/sitemap/", label: "Sitemap", exact: false },
];

function isCurrent(href: string, exact: boolean): boolean {
  if (exact) {
    return currentPath === href;
  }
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="site-brand" aria-label="Dhruv Patel - Home">
      <div class="site-brand-avatar-wrap">
        <img
          src="/images/pro_pic_small.jpg"
          alt="Dhruv Patel"
          width="44"
          height="44"
          class="site-brand-avatar"
          loading="eager"
        />
        <span class="status-pulse-dot" title="Active Lead Mobile & AI Engineer" aria-hidden="true"></span>
      </div>
      <div class="site-brand-text">
        <span class="site-brand-name">Dhruv Patel</span>
        <span class="site-brand-title">Lead Android Engineer</span>
      </div>
    </a>

    <nav class="site-nav" id="site-navigation" aria-label="Main Navigation">
      <ul class="site-nav-list">
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class="site-nav-link"
              aria-current={isCurrent(item.href, item.exact) ? "page" : undefined}
            >
              <span>{item.label}</span>
              <span class="site-nav-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="site-nav-mobile-footer">
        <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="width: 100%; justify-content: center; gap: 6px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          <span>View Résumé (PDF)</span>
        </a>
      </div>
    </nav>

    <div class="site-header-actions">
      <a
        href="https://github.com/DearDhruv"
        target="_blank"
        rel="noopener noreferrer"
        class="header-icon-btn"
        aria-label="GitHub Profile"
        title="GitHub @DearDhruv"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
      </a>

      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="header-resume-btn"
        aria-label="Download Résumé PDF"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
        <span>Résumé</span>
      </a>

      <button
        class="theme-toggle-btn theme-toggle"
        id="theme-toggle"
        aria-label="Switch to light theme"
        aria-pressed="false"
        type="button"
      >
        <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <span class="theme-toggle-label">Theme</span>
      </button>

      <button
        class="menu-toggle-btn"
        id="menu-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="site-navigation"
        type="button"
      >
        <svg class="menu-icon-bars" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="menu-icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
  <div class="site-nav-backdrop" id="site-nav-backdrop" aria-hidden="true"></div>
</header>
