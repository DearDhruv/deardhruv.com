---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { href: "/", label: "Home", exact: true },
  { href: "/about/", label: "About", exact: false },
  { href: "/portfolio/", label: "Portfolio", exact: false },
  { href: "/projects/", label: "Projects", exact: false },
  { href: "/posts/", label: "Writing", exact: false },
  { href: "/sitemap/", label: "Sitemap", exact: false },
];

function isCurrent(href: string, exact: boolean): boolean {
  if (exact) {
    return currentPath === href;
  }
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="site-brand">Dhruv Patel</a>
    <nav class="site-nav" id="site-navigation" aria-label="Main Navigation">
      <ul class="site-nav-list">
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class="site-nav-link"
              aria-current={isCurrent(item.href, item.exact) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="site-header-actions">
      <button
        class="theme-toggle-btn theme-toggle"
        id="theme-toggle"
        aria-label="Switch to light theme"
        aria-pressed="false"
        type="button"
      >
        <span class="theme-toggle-label">Theme</span>
      </button>
      <button
        class="menu-toggle-btn"
        id="menu-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="site-navigation"
        type="button"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>
