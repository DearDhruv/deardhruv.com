---
/**
 * Feature-Flagged Palette Switcher Component.
 * Enables real-time switching between the 4 WCAG 2.2 AA compliant engineering palettes:
 * 1. Precision Cyan (Default)
 * 2. Terminal Emerald
 * 3. Warm Editorial
 * 4. Electric Indigo
 */
const palettes = [
  { id: "amber", name: "Amber", color: "#fbbf24" },
  { id: "cyan", name: "Cyan", color: "#38bdf8" },
  { id: "emerald", name: "Emerald", color: "#34d399" },
  { id: "indigo", name: "Indigo", color: "#818cf8" }
];
---

<div id="palette-switcher-bar" class="palette-switcher-bar" role="toolbar" aria-label="Theme palette switcher" hidden>
  <span class="palette-switcher-title">Palette:</span>
  <div class="palette-options">
    {palettes.map(p => (
      <button
        type="button"
        class="palette-btn"
        data-palette-choice={p.id}
        aria-label={`${p.name} palette`}
        aria-pressed={p.id === "amber" ? "true" : "false"}
      >
        <span class="palette-swatch" style={`background-color: ${p.color};`}></span>
        <span>{p.name}</span>
      </button>
    ))}
  </div>
  <button type="button" class="palette-close-btn" id="palette-close-btn" aria-label="Close palette switcher">&times;</button>
</div>
