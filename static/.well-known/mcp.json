{
  "$schema": "https://static.modelcontextprotocol.io/schemas/mcp-server-card/v1.json",
  "version": "1.0",
  "protocolVersion": "2024-11-05",
  "serverInfo": {
    "name": "DearDhruv Engineering Portfolio & Articles",
    "version": "2.1.0",
    "description": "Technical portfolio and publications of Dhruv Patel (@DearDhruv), Lead Android Engineer and Android Architect. Covers Android architecture, Kotlin Multiplatform, on-device AI runtimes, and hardware-integrated systems."
  },
  "transport": {
    "type": "streamable-http",
    "url": "https://deardhruv.com/.well-known/mcp.json"
  },
  "capabilities": {
    "resources": [
      {
        "uri": "https://deardhruv.com/index.json",
        "name": "Site Content Feed",
        "mimeType": "application/feed+json"
      },
      {
        "uri": "https://deardhruv.com/llms.txt",
        "name": "LLM Core Directory",
        "mimeType": "text/markdown"
      },
      {
        "uri": "https://deardhruv.com/llms-full.txt",
        "name": "LLM Full Content Directory",
        "mimeType": "text/markdown"
      },
      {
        "uri": "https://deardhruv.com/index.md",
        "name": "Root Markdown Mirror",
        "mimeType": "text/markdown"
      }
    ],
    "tools": []
  }
}
